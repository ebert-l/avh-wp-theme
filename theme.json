{
	"version": 0,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "weiss",
					"color": "#ffffff",
					"name": "Weiss"
				},
				{
					"slug": "schwarz",
					"color": "#000000",
					"name": "Schwarz"
				},
				{
					"slug": "wappen",
					"color": "#67cbe9",
					"name": "Wappen"
				},
				{
					"slug": "highlight",
					"color": "#f6ff00",
					"name": "Highlight"
				},
				{
					"slug": "grau",
					"color": "#959595",
					"name": "Grau"
				},
				{
					"slug": "transparent",
					"color": "transparent",
					"name": "Transparent"
				}
			],
			"gradients": [
				{
					"slug": "wappen-white",
					"gradient": "linear-gradient(#67cbe9 49.9%,#fff 50%)",
					"name": "wappen color to white"
				},
				{
					"slug": "white-wappen",
					"gradient": "linear-gradient(#fff 49.9%,#67cbe9 50%)",
					"name": "Horizontal white to wappen color"
				}
			],
			"duotone": [
				{
					"colors": [ "#f6ff00", "#67cbe9"],
					"slug": "highlight-wappen",
					"name": "highlight and wappen"
				},
				{
					"colors": ["#67cbe9", "#000000"],
					"slug": "wappen-schwarz",
					"name": "wappen and schwarz"
				}
			]
		},
		"layout": {
			"contentSize": "700px",
			"wideSize": "1100px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "Inter",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "200 300 500 800",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/inter/Inter.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "1.125rem",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1.5rem",
					"name": "Medium",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "2rem",
					"name": "Large",
					"fluid": {
						"min": "1.75rem",
						"max": "2rem"
					}
				},
				{
					"slug": "x-large",
					"size": "2.75rem",
					"name": "XL",
					"fluid": {
						"min": "2.5rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "3.75rem",
					"name": "XXL",
					"fluid": {
						"min": "3rem",
						"max": "3.75rem"
					}
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/code": {
				"color": {
					"text": "var(--wp--preset--color--schwarz)"
				}
			},
			"core/comment-author-name": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/comment-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/comment-edit-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-comments-form": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/comment-reply-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/navigation": {
				"css": "& .wp-block-site-title{ margin:0; font-weight:400;}",
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--schwarz)"
						},
						"typography": {
							"textDecoration": "underline"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--schwarz)"
							},
							"typography": {
								"textDecoration": "none"
							}
						},
						":focus": {
							"color": {
								"text": "var(--wp--preset--color--schwarz)"
							}
						},
						":active": {
							"color": {
								"text": "var(--wp--preset--color--schwarz)"
							}
						}
					}
				}
			},
			"core/post-author-name": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-content": {
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--60)",
						"bottom": "var(--wp--preset--spacing--60)"
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-excerpt": {
				"elements": {
					"link": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--small)"
						}
					}
				}
			},
			"core/post-featured-image": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/post-template": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/query-pagination": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/search": {
				"css": ".wp-block-search__button-inside .wp-block-search__inside-wrapper{border: none;}",
				"typography": {
					"lineHeight": "1"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--weiss)",
			"text": "var(--wp--preset--color--schwarz)"
		},
		"elements": {
			"button": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--50)"
					}
				},
				"border": {
					"color": "var(--wp--preset--color--schwarz)",
					"width": "4px",
					"style": "solid",
					"radius": "0px"
				},
				"color": {
					"background": "var(--wp--preset--color--schwarz)",
					"text": "var(--wp--preset--color--weiss)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normal)",
					"fontWeight": "500"
				},
				"shadow": "none",
				":hover": {
					"border": {
						"color": "var(--wp--preset--color--wappen)"
					},
					"color": {
						"background":"var(--wp-preset-color-wappn)",
						"text":"var(--wp-preset-color-schwarz)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--wappen)"
				}
			},
			"cite": {
				"color": {
					"text": "var(--wp--preset--color--wappen)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--schwarz)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--schwarz)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--schwarz)"
					}
				},
				":active": {
					"color": {
						"text": "var(--wp--preset--color--schwarz)"
					}
				}
			}
		},
		"spacing": {
			"padding": {
				"right": "var(--wp--preset--spacing--50)",
				"left": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontFamily": "var(--wp--preset--font-family--system)",
			"lineHeight": "1.7"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "no-title",
			"title": "No title",
			"postTypes": [ "post","page" ]
		}
	]
}
